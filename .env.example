PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/qfood
CLIENT_URL=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Quantum microservice (Python / FastAPI)
QUANTUM_SERVICE_URL=http://localhost:8001
QUANTUM_MODE=simulator            # simulator | cloud  (cloud also needs IBM_QUANTUM_TOKEN in quantum-service/.env)
QUANTUM_AUTO_MATCH=true           # rematch automatically on triggers
QUANTUM_DEBOUNCE_MS=8000

# AI food quality: none | dev | anthropic | http
AI_PROVIDER=dev
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
AI_HTTP_ENDPOINT=                 # your own model server, POST multipart image -> JSON

# Storage: local | cloudinary
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional external services (app works without them)
SMS_PROVIDER=console              # console | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TRANSLATE_PROVIDER=none           # none | libretranslate
LIBRETRANSLATE_URL=
ROUTING_PROVIDER=haversine        # haversine | osrm
OSRM_URL=https://router.project-osrm.org
PAYMENT_PROVIDER=none             # none | razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
